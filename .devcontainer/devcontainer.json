// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go-postgres
{
    "name": "Aegion Agriworks Backend",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/devcontainers/features/python:1": {},
        "ghcr.io/devcontainers-extra/features/poetry:2": {},
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "mounts": [
        {
            "source": "/var/run/docker.sock",
            "target": "/var/run/docker-host.sock",
            "type": "bind"
        }
    ],
    // Use this environment variable if you need to bind mount your local source code into a new container.
    "remoteEnv": {
        "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
    },
    // Use 'forwardPorts' to make a list of ports inside the container available locally.
    "forwardPorts": [
        3000,
        8000,
        8501,
        8502,
        8503,
        8504,
        8505,
        8506,
        8507,
        9000,
        9001,
        27017,
        5432
    ],
    "portsAttributes": {
        "3000": {
            "label": "Frontend (Next.js)",
            "onAutoForward": "notify"
        },
        "8000": {
            "label": "Backend (FastAPI)",
            "onAutoForward": "silent"
        },
        "8501": {
            "label": "Dashboard: Purchase & Sales",
            "onAutoForward": "silent"
        },
        "8502": {
            "label": "Dashboard: Revenue Analysis",
            "onAutoForward": "silent"
        },
        "8503": {
            "label": "Dashboard: Stock Movement",
            "onAutoForward": "silent"
        },
        "8504": {
            "label": "Dashboard: Kisan Mitra",
            "onAutoForward": "silent"
        },
        "8505": {
            "label": "Dashboard: Stock Inventory",
            "onAutoForward": "silent"
        },
        "8506": {
            "label": "Dashboard: Farmer Income",
            "onAutoForward": "silent"
        },
        "8507": {
            "label": "Dashboard: NF Coordinator",
            "onAutoForward": "silent"
        },
        "9000": {
            "label": "MinIO API (S3)",
            "onAutoForward": "silent"
        },
        "9001": {
            "label": "MinIO Console",
            "onAutoForward": "silent"
        },
        "27017": {
            "label": "MongoDB",
            "onAutoForward": "silent"
        },
        "5432": {
            "label": "PostgreSQL",
            "onAutoForward": "silent"
        }
    },
    // Configure tool-specific properties.
    "customizations": {
        // Configure properties specific to VS Code.
        "vscode": {
            // Add the IDs of extensions you want installed when the container is created.
            "extensions": [
                "ms-azuretools.vscode-docker",
                "GitHub.copilot",
                "ms-vscode.makefile-tools",
                "GitHub.copilot-chat",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg",
                "tamasfe.even-better-toml",
                "hashicorp.hcl"
            ]
        }
    },
    // Use 'postCreateCommand' to run commands after the container is created.
    // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
    "remoteUser": "root"
}